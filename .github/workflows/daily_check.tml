name: Daily Slacking Check

on:
  schedule:
    # 毎日UTC 11:00（日本時間の夜20:00）に実行
    - cron: '0 11 * * *'
  workflow_dispatch: # 手動でテスト実行するためのボタンを設置

jobs:
  run-analysis:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install requests python-dotenv numpy

    - name: Run test_send.py
      env:
        TOGGL_API_KEY: ${{ secrets.TOGGL_API_KEY }}
        GMAIL_USER: ${{ secrets.GMAIL_USER }}
        GMAIL_APP_PASSWORD: ${{ secrets.GMAIL_APP_PASSWORD }}
      run: python test_send.py
